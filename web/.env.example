# Base URL of the FastAPI backend. In dev the Vite proxy handles /api, so this
# can stay empty. In production (Vercel) set it to your Render backend URL.
VITE_API_BASE_URL=

# Cloudflare Turnstile SITE key (public, browser-side). DORMANT until set — the
# login CAPTCHA widget renders only when this is present. Must be the SITE key
# from the SAME Turnstile widget whose SECRET key is set as TURNSTILE_SECRET_KEY
# in server/.env. Get both at https://dash.cloudflare.com/ -> Turnstile.
VITE_TURNSTILE_SITE_KEY=
