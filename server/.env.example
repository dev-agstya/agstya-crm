# Copy to .env and fill in real values. NEVER commit the real .env.

# --- Security / JWT ---
SECRET_VALUE=change_me_random_secret
JWT_SECRET=change_me_long_random_jwt_secret
JWT_EXPIRE_HOURS=3

# --- Email (Gmail SMTP) ---
GMAIL_USERNAME=your.address@gmail.com
MAIL_FROM="AgastyaCRM <your.address@gmail.com>"
GMAIL_APP_PWD=your_16_char_app_password

# --- Database (MongoDB Atlas) ---
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/?appName=AgastyaCRM
MONGO_DB_NAME=agastyacrm

# --- AWS S3 ---
AWS_ACCESS_KEY_ID=your_key
AWS_SECRET_ACCESS_KEY=your_secret
AWS_REGION=eu-north-1
AWS_BUCKET_NAME=agastyacrm-storage-dev

# --- Frontend origin(s) for CORS + email links ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_BASE_URL=http://localhost:5173

# --- WhatsApp (Meta Cloud API) ---
# DORMANT until the phone-number id + access token are set. Runtime on/off and
# the per-message send matrix live in Administration -> Third Party Services (DB),
# not here. A test phone-number id can only reach numbers you've verified in Meta.
WHATSAPP_TEST_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=

# --- Channel Partner portal ---
# The portal shipped on 2026-08-05 and has NO environment gate. It is controlled
# entirely in-app, by two switches: the master one at Channel Partners -> Portal
# settings, and `portal_access` on each partner. Both are checked on every
# request, so switching the master one off signs every partner out at once.

# --- CAPTCHA (Cloudflare Turnstile) ---
# DORMANT until TURNSTILE_SECRET_KEY is set. When set, the login form requires a
# Turnstile token after CAPTCHA_AFTER_FAILURES failed attempts from the same IP.
# Get keys at https://dash.cloudflare.com/ -> Turnstile -> Add site.
# The SECRET key goes here (server-side verify). The SITE key goes in web/.env
# as VITE_TURNSTILE_SITE_KEY (the browser widget). Keep the two in the same pair.
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=
CAPTCHA_AFTER_FAILURES=3

# --- Field encryption (Fernet) ---
# DORMANT when empty (values stored as plaintext). Generate a key with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Store it ONLY here, never in git. See extras/guide.txt to decrypt a DB dump.
DATA_ENCRYPTION_KEY=

# --- Rate limiting (in-process, per IP) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GLOBAL_PER_MIN=120
RATE_LIMIT_LOGIN_PER_MIN=10
RATE_LIMIT_REFRESH_PER_MIN=30
RATE_LIMIT_FORGOT_PER_HOUR=5
RATE_LIMIT_EXPORT_PER_MIN=10

# --- Ops ---
REQUEST_TIMEOUT_SECONDS=30      # hard cap -> clean 504 on slow requests
LOG_RETENTION_DAYS=180          # error/email/api logs auto-expire (TTL index)
ALERTS_ENABLED=true             # email the dev address on server errors
DEV_ALERT_EMAIL=work@rajanrajawat.in
